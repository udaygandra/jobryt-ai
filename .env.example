# ==============================================================================
# Jobryt AI Agent — Environment Configuration Template
# ==============================================================================

# --- 1. Telegram Bot (Mandatory for alerts & commands) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 2. AI / LLM Provider Configuration ---
# Active provider: gemini (default), openai, claude, groq, deepseek, openrouter, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (required only if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Groq (required only if LLM_PROVIDER=groq)
GROQ_API_KEY=

# DeepSeek (required only if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# OpenRouter (required only if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Ollama local inference (required only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- 3. Job Board Integrations (Optional) ---
# Note: LinkedIn, Canada Job Bank, Jobicy, Remotive, Himalayas, and ArbeitNow work without keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=

# --- 4. System Settings & Runtime Paths ---
DATA_DIR=./data
SCRIPTS_DIR=./scripts
PROMPTS_DIR=./prompts
TIMEZONE=America/Toronto
MIN_SCORE_THRESHOLD=60
MAX_UPLOAD_SIZE_MB=5
ADZUNA_COUNTRY=
ADZUNA_SEARCH_ROLE=
ADZUNA_SEARCH_LOCATION=

# --- 5. Outbound SMTP Email (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- 6. Deployment & Tunneling (Optional) ---
WEBHOOK_URL=
CLOUDFLARE_TUNNEL_TOKEN=